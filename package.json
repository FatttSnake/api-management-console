{
    "name": "api-management-console",
    "private": true,
    "type": "module",
    "version": "1.0.0-SNAPSHOT",
    "description": "Console of API Management",
    "author": {
        "name": "FatttSnake",
        "email": "fatttsnake@fatweb.top",
        "url": "https://fatweb.top"
    },
    "homepage": "https://api-console.fatweb.top",
    "scripts": {
        "dev": "vite",
        "dev-host": "vite --host 0.0.0.0",
        "build": "vite build && npm run typecheck",
        "build:package": "npm run build && sh package.sh $npm_package_version",
        "build-test": "cross-env NODE_ENV=development vite build --mode development && npm run typecheck",
        "build-dev": "cross-env NODE_ENV=development vite build --mode development",
        "typecheck": "tsc",
        "clean": "rimraf dist .eslintrc-auto-import.json auto-imports.d.ts",
        "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "format": "prettier --write src/",
        "preview": "vite preview"
    },
    "dependencies": {
        "@ant-design/icons": "^6.3.2",
        "@marsidev/react-turnstile": "^1.6.1",
        "@noble/hashes": "^2.3.0",
        "antd": "^6.6.1",
        "antd-style": "^4.1.0",
        "axios": "^1.20.0",
        "dayjs": "^1.11.23",
        "echarts": "^6.1.0",
        "jwt-decode": "^4.0.0",
        "localforage": "^1.10.0",
        "lodash": "^4.18.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-router": "^8.3.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@svgr/core": "^8.1.0",
        "@svgr/plugin-jsx": "^8.1.0",
        "@types/lodash": "^4.17.25",
        "@types/node": "^26.4.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@vitejs/plugin-react": "^6.1.0",
        "cross-env": "^10.1.0",
        "eslint": "^10.9.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "globals": "^17.11.0",
        "prettier": "^3.9.6",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.68.0",
        "unplugin-auto-import": "^21.1.0",
        "unplugin-icons": "^23.0.1",
        "vite": "^8.2.2"
    }
}
